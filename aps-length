DISPLAY_MATH_ENVS = ('equation', 'eqnarray', 'align', 'displaymath')
WORDCOUNT_FILTER_ENVS = DISPLAY_MATH_ENVS + (
    'acknowledgments', 'acknowledgements', 'abstract', 'thebibliography')
COMMENT_RE = re.compile(r"(?<!\\)%")
INCLUDEGRAPHICS_RE = re.compile(
    r"\\includegraphics\*?\s*(?:\[[^\]]*\]\s*)*\{(?P<filename>[^{}]+)\}",
    re.S)
TIKZ_FIGURE_RE = re.compile(r"\\begin\s*\{tikzpicture\}|\\tikz\b")
INPUT_RE = re.compile(r"\\(?:input|include)\s*\{(?P<filename>[^{}]+)\}")
PYMUPDF_MISSING_WARNED = False


def _env_begin_re(envs):
    env_pattern = '|'.join(re.escape(env) for env in envs)
    return re.compile(r'\\begin\{(?P<env>%s)(?P<star>\*)?\}' % env_pattern)


def _env_end_re(env_name):
    return re.compile(r'\\end\{%s\}' % re.escape(env_name))


DISPLAY_MATH_BEGIN_RE = _env_begin_re(DISPLAY_MATH_ENVS)


def _display_math_begin(line):
    match = DISPLAY_MATH_BEGIN_RE.search(line)
    if match is None:
        return None
    return match.group('env') + (match.group('star') or ''), match


def _comment_out_environment_blocks(lines, envs):
    begin_re = _env_begin_re(envs)
    filtered_lines = []
    active_env = None
    active_end_re = None

    for line in lines:
        rest = line
        while rest:
            if active_env is None:
                begin_match = begin_re.search(rest)
                if begin_match is None:
                    filtered_lines.append(rest)
                    break

                before = rest[:begin_match.start()]
                if before:
                    filtered_lines.append(before if before.endswith('\n') else before + '\n')

                active_env = begin_match.group('env') + (
                    begin_match.group('star') or '')
                active_end_re = _env_end_re(active_env)
                rest = rest[begin_match.start():]
            else:
                end_match = active_end_re.search(rest)
                if end_match is None:
                    filtered_lines.append('% ' + rest)
                    break

                commented = rest[:end_match.end()]
                if not commented.endswith('\n'):
                    commented += '\n'
                filtered_lines.append('% ' + commented)
                rest = rest[end_match.end():]
                active_env = None
                active_end_re = None

    return filtered_lines


def _add_documentclass_option(lines, option):
    documentclass_re = re.compile(r'(\\documentclass)(\s*)(?:\[([^\]]*)\])?')
    updated_lines = []

    for line in lines:
        if r'\documentclass' not in line:
            updated_lines.append(line)
            continue

        def add_option(match):
            opts = match.group(3)
            if opts is None:
                return '%s%s[%s]' % (match.group(1), match.group(2), option)

            existing_opts = [opt.strip() for opt in opts.split(',')]
            if option in existing_opts:
                return match.group(0)
            return '%s%s[%s, %s]' % (match.group(1), match.group(2), option, opts)

        updated_lines.append(documentclass_re.sub(add_option, line, count=1))

    return updated_lines


def _make_temp_tex_file(prefix, contents):
    fd, path = tempfile.mkstemp(prefix=prefix, suffix='.tex', dir='.')
    os.close(fd)
    path = os.path.basename(path)
    with io.open(path, 'w') as tex_file:
        if isinstance(contents, str):
            tex_file.write(contents)
        else:
            tex_file.writelines(contents)
    return path, os.path.splitext(path)[0]


def _cleanup_temp_outputs(*bases):
    for base in bases:
        for pattern in (base + '.*', base + 'Notes.bib'):
            for filename in glob.glob(pattern):
                os.unlink(filename)


def _format_cmd(cmd):
    return ' '.join(shlex.quote(str(part)) for part in cmd)


def _split_latex_comment(line):
    match = COMMENT_RE.search(line)
    if match is None:
        return line, None
    return line[:match.start()], line[match.end():]


def _strip_latex_comment(line):
    uncommented, comment = _split_latex_comment(line)
    if comment is None:
        return line

    newline = ''
    if comment.endswith('\r\n'):
        newline = '\r\n'
    elif comment.endswith('\n'):
        newline = '\n'
    elif comment.endswith('\r'):
        newline = '\r'
    return uncommented + '% ' + newline


def _has_stop_comment(line, stop_comment):
    if not stop_comment:
        return False
    _, comment = _split_latex_comment(line)
    return comment is not None and stop_comment in comment


def _decode_command_output(output):
    return output.decode(PREFERRED_ENCODING, errors='replace')


def _run_capture(cmd, stdin=None):
    try:
        return subprocess.run(cmd, stdin=stdin, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE)
    except FileNotFoundError:
        raise RuntimeError("Could not find command '%s'" % cmd[0])


def _tail_text(text, max_lines=20):
    lines = text.strip().splitlines()
    if len(lines) <= max_lines:
        return '\n'.join(lines)
    return '\n'.join(lines[-max_lines:])


def _read_log_tail(base, max_lines=20):
    log_path = base + '.log'
    if not os.path.exists(log_path):
        return ''
    with io.open(log_path, errors='replace') as log_file:
        return _tail_text(log_file.read(), max_lines=max_lines)


def _run_quiet(cmd, input_text=None):
    try:
        return subprocess.run(cmd, input=input_text, text=input_text is not None,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except FileNotFoundError:
        raise RuntimeError("Could not find command '%s'" % cmd[0])


def _print_command_failure(cmd, completed, log_base=None):
    print("*** Error encountered when running '%s' ***" % _format_cmd(cmd))

    stdout = _tail_text(_decode_command_output(completed.stdout))
    stderr = _tail_text(_decode_command_output(completed.stderr))
    log_tail = _read_log_tail(log_base) if log_base else ''

    if stderr:
        print('--- stderr ---')
        print(stderr)
    if stdout:
        print('--- stdout ---')
        print(stdout)
    if log_tail:
        print('--- %s.log tail ---' % log_base)
        print(log_tail)


def _find_matching_line(lines, needle, description):
    matches = [i for i, line in enumerate(lines) if needle in line]
    if not matches:
        raise ValueError('Could not find %s' % description)
    return matches[0]


def _find_environment_bounds(lines, env):
    begin_line = _find_matching_line(lines, r'\begin{%s}' % env,
                                     r'\begin{%s}' % env)
    for i, line in enumerate(lines[begin_line + 1:], begin_line + 1):
        if r'\end{%s}' % env in line:
            return begin_line, i
    raise ValueError(r'Could not find \end{%s}' % env)


def _parse_identify_dimensions(filename):
    identify = _run_capture(['identify', filename])
    if identify.returncode != 0:
        raise RuntimeError("identify failed for %s: %s" %
                           (filename, _decode_command_output(identify.stderr).strip()))

    output = _decode_command_output(identify.stdout)
    fields = output.split()
    dimensions = re.match(r'(?P<width>\d+(?:\.\d+)?)x(?P<height>\d+(?:\.\d+)?)',
                          fields[2] if len(fields) >= 3 else '')
    if dimensions is None:
        raise RuntimeError("Could not parse identify output for %s: %s" %
                           (filename, output.strip()))

    return float(dimensions.group('width')), float(dimensions.group('height'))


def _parse_gs_dimensions(filename):
    with io.open(filename, 'rb') as img_f:
        gs = _run_capture(['gs', '-q', '-dSAFER', '-dBATCH', '-sDEVICE=bbox', '-'],
                          stdin=img_f)
    if gs.returncode != 0:
        raise RuntimeError("gs failed for %s: %s" %
                           (filename, _decode_command_output(gs.stderr).strip()))

    bbox = _decode_command_output(gs.stderr).split('\n')[0].split()
    if len(bbox) < 5:
        raise RuntimeError("Could not parse gs bbox output for %s: %s" %
                           (filename, _decode_command_output(gs.stderr).strip()))

    return float(bbox[3]), float(bbox[4])


def _parse_pdf_dimensions(filename):
    try:
        import fitz
    except ImportError:
        _warn_pymupdf_missing()
        return _parse_gs_dimensions(filename)

    try:
        pdf_file = fitz.open(filename)
    except Exception as err:
        raise RuntimeError('PyMuPDF failed to open %s: %s' % (filename, err))

    try:
        if len(pdf_file) == 0:
            raise RuntimeError('PDF figure has no pages: %s' % filename)

        first_page = pdf_file[0]
        return float(first_page.rect.width), float(first_page.rect.height)
    finally:
        pdf_file.close()


def _warn_pymupdf_missing():
    global PYMUPDF_MISSING_WARNED

    if PYMUPDF_MISSING_WARNED:
        return

    print()
    print('*' * 72)
    print('*** WARNING: PyMuPDF is not installed ***')
    print('PDF figure dimensions are falling back to Ghostscript.')
    print('Install PyMuPDF with "python3 -m pip install PyMuPDF" for the')
    print('more accurate PDF figure sizing used by upstream aps-length.')
    print('*' * 72)
    print()
    PYMUPDF_MISSING_WARNED = True


def _parse_figure_dimensions(filename, opts):
    if os.path.splitext(filename)[1].lower() == '.pdf':
        return _parse_pdf_dimensions(filename)
    if opts.figs == 'identify':
        return _parse_identify_dimensions(filename)
    if opts.figs == 'gs':
        return _parse_gs_dimensions(filename)
    raise ValueError('Unknown figure method "%s"' % opts.figs)


def _line_offsets(lines):
    offsets = []
    offset = 0
    for line in lines:
        offsets.append(offset)
        offset += len(line)
    return offsets


def _line_number_for_offset(offsets, offset):
    return bisect.bisect_right(offsets, offset) - 1


def _includegraphics_commands(tex_lines):
    commands = []
    source = ''.join(tex_lines)
    offsets = _line_offsets(tex_lines)

    for match in INCLUDEGRAPHICS_RE.finditer(source):
        filename = ' '.join(match.group('filename').split())
        commands.append({
            'start_line': _line_number_for_offset(offsets, match.start()),
            'end_line': _line_number_for_offset(offsets, match.end()),
            'start_pos': match.start(),
            'end_pos': match.end(),
            'source': match.group(0),
            'filename': filename,
        })

    unmatched_source = INCLUDEGRAPHICS_RE.sub('', source)
    if r'\includegraphics' in unmatched_source:
        command_start = unmatched_source.find(r'\includegraphics')
        raise ValueError('Could not parse includegraphics command near: %s' %
                         unmatched_source[command_start:command_start + 120].strip())

    return commands


def _figure_environments(tex_lines):
    figures = []

    for start_line, line in enumerate(tex_lines):
        if r'\begin{figure' not in line:
            continue

        for end_line in range(start_line, len(tex_lines)):
            if r'\end{figure' in tex_lines[end_line]:
                figures.append({
                    'start_line': start_line,
                    'end_line': end_line,
                    'two_column': 'figure*' in line,
                })
                break
        else:
            raise ValueError('Could not find figure environment end after line %d' %
                             (start_line + 1))

    return figures


def _resolve_tex_input(filename, base_dir='.'):
    filename = ' '.join(filename.split())
    candidates = [os.path.join(base_dir, filename)]
    if not os.path.splitext(filename)[1]:
        candidates.append(os.path.join(base_dir, filename + '.tex'))

    for candidate in candidates:
        if os.path.exists(candidate):
            return candidate
    return None


def _find_tikz_in_input_file(filename, base_dir='.', seen=None):
    if seen is None:
        seen = set()

    path = _resolve_tex_input(filename, base_dir=base_dir)
    if path is None:
        return None

    abs_path = os.path.abspath(path)
    if abs_path in seen:
        return None
    seen.add(abs_path)

    with io.open(path, errors='replace') as tex_input:
        for line in tex_input:
            uncommented, _ = _split_latex_comment(line)
            if TIKZ_FIGURE_RE.search(uncommented):
                return path

            nested_base_dir = os.path.dirname(path) or '.'
            for match in INPUT_RE.finditer(uncommented):
                nested_path = _find_tikz_in_input_file(
                    match.group('filename'), base_dir=nested_base_dir, seen=seen)
                if nested_path is not None:
                    return nested_path

    return None


def _find_tikz_line(tex_lines, figure):
    for line_no in range(figure['start_line'], figure['end_line'] + 1):
        uncommented, _ = _split_latex_comment(tex_lines[line_no])
        if TIKZ_FIGURE_RE.search(uncommented):
            return line_no, None

        for match in INPUT_RE.finditer(uncommented):
            input_path = _find_tikz_in_input_file(match.group('filename'))
            if input_path is not None:
                return line_no, input_path
    return None


def _tikz_figure_error(tikz_ref):
    line_no, input_path = tikz_ref
    message = (
        'TikZ figure encountered near line %d. aps-length cannot '
        'estimate inline TikZ reliably; build it to a PDF and include '
        r'it with \includegraphics.' % (line_no + 1))
    if input_path is not None:
        message += ' TikZ was found in %s.' % input_path
    return ValueError(message)


def _check_no_tikz_figures(tex_lines):
    for figure in _figure_environments(tex_lines):
        tikz_ref = _find_tikz_line(tex_lines, figure)
        if tikz_ref is not None:
            raise _tikz_figure_error(tikz_ref)


def _command_line_breaks_between(source, left_command, right_command):
    between = source[left_command['end_pos']:right_command['start_pos']]
    return (r'\\' in between or r'\newline' in between or r'\par' in between
            or re.search(r'\n\s*\n', between) is not None)


def _combined_figure_dimensions(source, commands, dimensions):
    rows = []
    row = []

    for i, (command, dimension) in enumerate(zip(commands, dimensions)):
        if i > 0 and _command_line_breaks_between(source, commands[i - 1], command):
            rows.append(row)
            row = []
        row.append(dimension)

    if row:
        rows.append(row)

    row_sizes = []
    for row in rows:
        row_width = sum(width for width, height in row)
        row_height = max(height for width, height in row)
        row_sizes.append((row_width, row_height))

    width = max(row_width for row_width, row_height in row_sizes)
    height = sum(row_height for row_width, row_height in row_sizes)
    return width, height


def _resolve_figure_filename(filename):
    candidates = []
    for ext in ['', '.pdf', '.eps', '.png']:
        candidate = filename + ext
        if os.path.exists(candidate):
            candidates.append(candidate)

    if not candidates:
        raise IOError('missing picture file %s' % filename)

    if len(candidates) > 1:
        print("*** WARNING ***: multiple picture files match %s; using %s" %
              (filename, candidates[0]))

    return candidates[0]


def is_first_line(line):
    if line.strip() == '':
        return False
    if '%' in line:
        return False
    return True


def count_main_text_words_detex(detex_lines, tex_lines):
    # remove images and empty lines
    detex_lines = [line for line in detex_lines if len(line.strip()) > 0]
    detex_lines = [line for line in detex_lines if '<Picture' not in line]

    title_line_no = _find_matching_line(tex_lines, r'\maketitle', r'\maketitle')
    first_line_no = title_line_no + 1
    if first_line_no >= len(tex_lines):
        raise ValueError(r'Could not find main text after \maketitle')
    while not is_first_line(tex_lines[first_line_no]):
        first_line_no += 1
        if first_line_no >= len(tex_lines):
            raise ValueError(r'Could not find main text after \maketitle')
    first_line = tex_lines[first_line_no]

    detex_first_line_no = None
    for i, line in enumerate(detex_lines):
        if line.strip() in first_line.strip():
            detex_first_line_no = i
            break
    if detex_first_line_no is None:
        raise ValueError('Could not locate first main-text line in detex output')

    main_text = detex_lines[detex_first_line_no:]

    # Hyphenated compounds count as multiple words under the APS guide.
    main_text = [line.replace('-', ' ') for line in main_text]
    lines_words = [line.split() for line in main_text]
    words = [word for words in lines_words for word in words]

    main_text_words = len(words)
    return main_text_words


def count_main_text_words_wordcount(tex_lines, opts):
    """
    Count words in main text following method described at

    http://journals.aps.org/authors/length-guide-faq
    """
    mod_tex_lines = tex_lines[:]

    # Commenting out the \maketitle command
    mod_tex_lines = [line.replace(r'\maketitle', r'%\maketitle')
                     for line in mod_tex_lines]

    # Using the 'nofootinbib' option
    mod_tex_lines = _add_documentclass_option(mod_tex_lines, 'nofootinbib')

    # Commenting out the \bibliographystyle command
    mod_tex_lines = [line.replace(r'\bibliographystyle', r'%\bibliographystyle')
                     for line in mod_tex_lines]

    # Putting an \end{document} before the bibliography
    bib_index = [i for (i, line) in enumerate(mod_tex_lines)
                 if r'\bibliography{' in line]
    if bib_index:
        mod_tex_lines.insert(bib_index[0], r'\end{document}' + '\n')

    # Putting an \end{document} before acknowledgments/acknowledgements.
    ack_index = [i for (i, line) in enumerate(mod_tex_lines)
                 if r'\acknowle' in line]
    if ack_index:
        mod_tex_lines.insert(ack_index[0], r'\end{document}' + '\n')

    # Comment out any display equations and acknowledgments
    mod_tex_lines = _comment_out_environment_blocks(mod_tex_lines, WORDCOUNT_FILTER_ENVS)

    # FIXME - Commenting out the rows (but not the caption) of any tables

    tmp_tex_path, tmp_tex_base = _make_temp_tex_file('aps_length_tmp_', mod_tex_lines)
    _, wordcount_tex_base = _make_temp_tex_file(
        'aps_length_wordcount_', WORDCOUNT_TEX_CONTENTS)

    try:
        latex_cmd = shlex.split(opts.latex) + shlex.split(opts.latexopts)
        cmds = [(latex_cmd + [tmp_tex_base], None, tmp_tex_base),
                (['bibtex', tmp_tex_base], None, None),
                (latex_cmd + [tmp_tex_base], None, tmp_tex_base),
                (latex_cmd + [tmp_tex_base], None, tmp_tex_base),
                (latex_cmd + [wordcount_tex_base], tmp_tex_path + '\n',
                 wordcount_tex_base)]
        for cmd, input_text, log_base in cmds:
            completed = _run_quiet(cmd, input_text=input_text)

            if completed.returncode != 0:
                _print_command_failure(cmd, completed, log_base=log_base)

                if not opts.ignoreerrors:
                    raise RuntimeError('LaTeX error encountered')
                else:
                    print('Trying to continue')
                    print()

        # this does not have a defined encoding in latex, so just read it as bytes
        with io.open(wordcount_tex_base + '.log', 'rb') as wordcount_log_file:
            wordcount_log = wordcount_log_file.readlines()

        wordcount = len([line for line in wordcount_log
                         if b'3.08633' in line or b'3.08635' in line])
        return wordcount
    finally:
        if not opts.keep_tmp_files:
            _cleanup_temp_outputs(tmp_tex_base, wordcount_tex_base)


def find_equation_lines(tex_lines):
    return [i for (i, line) in enumerate(tex_lines) if _display_math_begin(line)]


def is_in_widetext(lines, line_no):
    in_widetext = False
    for line in lines[:line_no+1]:
        if r'\begin{widetext}' in line:
            in_widetext = True
        if r'\end{widetext}' in line:
            in_widetext = False
    return in_widetext


def count_equation_words(lines, start_line):
    count = 1
    array = False
    array_lines = 0
    two_column = is_in_widetext(lines, start_line)
    if two_column:
        eqn_words_per_line = 32
    else:
        eqn_words_per_line = 16

    begin_info = _display_math_begin(lines[start_line])
    if begin_info is None:
        return 0
    env_name, begin_match = begin_info
    env_end_re = _env_end_re(env_name)
    if env_end_re.search(lines[start_line], begin_match.end()):
        return count*eqn_words_per_line

    for line in lines[start_line+1:]:
        if env_end_re.search(line):
            break
        if r'\\' in line:
            if not array:
                count += 1
            else:
                array_lines += 1
        if r'\begin{array}' in line:
            array = True
            array_lines = 0
        if r'\end{array}' in line:
            array = False

    if array_lines != 0:
        count *= array_lines

    return count*eqn_words_per_line


def count_equations_words(tex_lines):
    eqn_line_nos = find_equation_lines(tex_lines)
    eqn_words = [count_equation_words(tex_lines, eqn_line_no)
                 for eqn_line_no in eqn_line_nos]
    print('Equations: %r' % eqn_words)
    return sum(eqn_words)


def find_table_lines(tex_lines):
    return [i for (i, line) in enumerate(tex_lines) if r'\begin{tabl' in line]


def count_table_words(tex_lines, table_line):
    two_column = 'table*' in tex_lines[table_line]
    count = 1
    for line in tex_lines[table_line:]:
        if r'\end{table' in line:
            break
        if r'\\' in line:
            count += 1
    if two_column:
        print('Two-column table with %d lines' % count)
        return int(13.*count + 26.)
    else:
        print('Single-column table with %d lines' % count)
        return int(6.5*count + 13.)


def count_tables_words(tex_lines):
    table_lines = find_table_lines(tex_lines)
    table_words = [count_table_words(tex_lines, table_line)
                   for table_line in table_lines]
    print('Tables: %r' % table_words)
    return sum(table_words)


def count_figures_words(tex_lines, opts):
    if opts.var is None:
        tex_vars = {}
    else:
        tex_vars = dict(opts.var)

    source = ''.join(tex_lines)
    fig_commands = _includegraphics_commands(tex_lines)
    figure_envs = _figure_environments(tex_lines)
    fig_words = []

    for command in fig_commands:
        if not any(figure['start_line'] <= command['start_line'] <= figure['end_line']
                   for figure in figure_envs):
            print("*** WARNING ***: ignoring includegraphics outside figure "
                  "environment: %s" % command['filename'])

    for fig_i, figure in enumerate(figure_envs):
        tikz_ref = _find_tikz_line(tex_lines, figure)
        if tikz_ref is not None:
            raise _tikz_figure_error(tikz_ref)

        figure_commands = [
            command for command in fig_commands
            if figure['start_line'] <= command['start_line'] <= figure['end_line']]
        if not figure_commands:
            continue

        filenames = []
        dimensions = []
        for command in figure_commands:
            filename = command['filename']

            for key in tex_vars.keys():
                if key in filename:
                    filename = filename.replace(key, tex_vars[key])

            filename = _resolve_figure_filename(filename)
            filenames.append(filename)
            dimensions.append(_parse_figure_dimensions(filename, opts))

        width, height = _combined_figure_dimensions(
            source, figure_commands, dimensions)
        aspect = float(width / height)

        if figure['two_column']:
            words_equiv = 300./(0.5*aspect) + 40.
        else:
            words_equiv = 150./aspect + 20.

        filename_label = ', '.join(filenames)
        if len(filenames) > 1:
            filename_label = '%d panels: %s' % (len(filenames), filename_label)

        print('Figure %d:   %6d words (%.0fx%.0f aspect %.2f, %s)' %
              (fig_i + 1, int(words_equiv), width, height, aspect, filename_label))
        fig_words.append(words_equiv)

    return int(sum(fig_words) * opts.scale_figs)


def count_chars_abstract(tex_lines):
    abs_begin_line, abs_end_line = _find_environment_bounds(tex_lines, 'abstract')

    abstract_lines = tex_lines[abs_begin_line+1:abs_end_line]
    abstract_lines = [line for line in abstract_lines if not line.startswith('%')]
    abstract = ''.join(abstract_lines)
    print('ABSTRACT:')
    print(abstract)
    return len(abstract)


def detex_lines_for_tex_lines(tex_lines, opts):
    detex_tex_path, detex_tex_base = _make_temp_tex_file('aps_length_detex_', tex_lines)
    try:
        detex = _run_capture(['detex', '-e', opts.env, detex_tex_path])
        if detex.returncode != 0:
            raise RuntimeError("detex failed for %s: %s" %
                               (detex_tex_path,
                                _decode_command_output(detex.stderr).strip()))
        return _decode_command_output(detex.stdout).strip().split('\n')
    finally:
        if not opts.keep_tmp_files:
            _cleanup_temp_outputs(detex_tex_base)


def replace_display_dollars(line, in_equation):
    dollar_re = re.compile(r"(?<!\\)\$\$")

    def replace(match):
        nonlocal in_equation
        if in_equation:
            in_equation = False
            return r"\end{equation}"
        in_equation = True
        return r"\begin{equation}"

    return dollar_re.sub(replace, line), in_equation


def process(tex_file, opts):
    print('Processing TeX file: %s\n' % tex_file)

    tex_lines = []
    in_equation = False
    with io.open(tex_file) as tex_input:
        input_lines = tex_input.readlines()

    for l in input_lines:
        if _has_stop_comment(l, opts.stop_comment):
            print("*** Ending text, stop comment %r encountered ***" %
                  opts.stop_comment)
            tex_lines.append('\\end{document}\n')
            break

        if '%' in l:
            # Remove comments
            l = _strip_latex_comment(l)

        # Strip out txfonts insertion, it seems to cause errors
        if r'\usepackage' in l and 'txfonts' in l:
            l = re.sub(r"\\usepackage(\[[^\]]*\])?{txfonts}", "", l)
            if 'usepackage' in l and 'txtfonts' in l:
                print("*** WARNING ***: couldn't clip out txfonts usepackage "
                      "reference. Make sure its on its own line")
            if l.strip() == "":
                continue

        if l.strip() == r'\appendix' and not opts.appendix:
            print("*** Ending text, appendix encountered *** (line: '%s')" %
                  l.strip())
            tex_lines.append('\\end{document}\n')
            break

        if r'\bibliography ' in l or r'\bibliography{' in l:
            print("*** Ending text, bibliography encountered *** (line: '%s')" %
                  l.strip())
            tex_lines.append('\\end{document}\n')
            break

        # Replace equations
        l, in_equation = replace_display_dollars(l, in_equation)
        if r'\[' in l:
            l = re.sub(r'(?<!\\)\\\[', r"\\begin{equation}", l)
        if r'\]' in l:
            l = re.sub(r"(?<!\\)\\\]", r"\\end{equation}", l)
        tex_lines.append(l)

    _check_no_tikz_figures(tex_lines)

    abstract_chars = count_chars_abstract(tex_lines)
    print()
    print('Abstract:    %6d chars (max 600)' % abstract_chars)
    print()

    if opts.method == 'detex':
        detex_lines = detex_lines_for_tex_lines(tex_lines, opts)
        main_text_words = count_main_text_words_detex(detex_lines, tex_lines)
    elif opts.method == 'wordcount':
        main_text_words = count_main_text_words_wordcount(tex_lines, opts)
    else:
        raise ValueError('Unsupported method %s' % opts.method)

    eqn_words = count_equations_words(tex_lines)
    fig_words = count_figures_words(tex_lines, opts)
    table_words = count_tables_words(tex_lines)
    total_words = (main_text_words + eqn_words + fig_words + table_words)

    print()
    print('Main text:      %6d words' % main_text_words)
    print('Displayed Math: %6d words' % eqn_words)
    print('Figures:        %6d words' % fig_words)
    print('Tables:         %6d words' % table_words)
    print('TOTAL:          %6d words' % total_words)
    print()
    if opts.journal == 'None':
        print('Manuscript %s is currently %d words long' % (tex_file, total_words))
    else:
        wl = WORD_LIMITS[opts.journal]
        if total_words > wl:
            over_under = 'OVER'
        else:
            over_under = 'UNDER'
        percent_from_limit = abs(float(total_words - wl) / wl * 100.)
        print('Manuscript %s is currently %d words (%.0f%%) %s limit of %d '
              'words for journal %s' %
              (tex_file, total_words, percent_from_limit, over_under, wl, opts.journal))


def build_parser():
    parser = optparse.OptionParser(
        usage='%prog [options] tex-files',
        description="""
Count length of an APS manuscript formatted in LaTeX, following
guidelines described at http://journals.aps.org/authors/length-guide""")

    parser.add_option('-v', '--var', metavar='key value', nargs=2, action='append',
                      help='Define TeX variables e.g. to specify location of figure files.')
    parser.add_option('-e', '--env', metavar='env1,env2,...',
                      help='Comma-separated list of LaTeX environments to ignore.',
                      default=('abstract,acknowledgments,acknowledgements,'
                               'displaymath,equation,eqnarray,thebibliography'))
    parser.add_option('-x', '--appendix', action='store_true', default=False,
                      help='Include text after \\appendix environment.')
    parser.add_option('--stop-comment', metavar='TEXT',
                      default=DEFAULT_STOP_COMMENT,
                      help=('Stop counting when a LaTeX comment contains TEXT. '
                            'Use an empty string to disable. Default is "%default".'))
    parser.add_option('-m', '--method', metavar='(detex | wordcount)', default='wordcount',
                      help='''Tool to use to count words in main text. Default is wordcount.
detex is also supported (but tends to underestimate word count).''')
    parser.add_option('-f', '--figs', metavar='(identify | gs)',
                      help='''Tool to use to extract bounding box from figure.
The default is identify, which works for png, eps, and most image formats, but requires
ImageMagick to be installed. The other option is gs, which works with eps images.
PDF figures use PyMuPDF automatically when available, otherwise gs.''',
                      default='identify')
    parser.add_option('--scale-figs', type=float, default=1.1,
                      help='Scale estimate of figure word counts by factor, default 1.1 (10%)')
    parser.add_option('-j', '--journal', metavar='PRL', default='None',
                      help='Journal abbreviation (e.g. None, PRL, PRB-RC)')
    parser.add_option('-l', '--latex', default='pdflatex',
                      help='Latex executable. Default is "pdflatex".')
    parser.add_option('-o', '--latexopts', default='-halt-on-error',
                      help='Options to latex executable. Default is "-halt-on-error".')
    parser.add_option('-i', '--ignoreerrors', action='store_true', default=False,
                      help='Try to continue even if LaTeX encounters errors')
    parser.add_option('--keep_tmp_files', action='store_true',
                      help=('Do not delete temporary latex files after running '
                            '(useful for debugging)'))
    return parser


def validate_options(parser, opts):
    if opts.journal != 'None' and opts.journal not in WORD_LIMITS:
        parser.error('unknown journal %r; choose one of: None, %s' %
                     (opts.journal, ', '.join(sorted(WORD_LIMITS))))

    if opts.method not in ('detex', 'wordcount'):
        parser.error("unknown method %r; choose 'detex' or 'wordcount'" %
                     opts.method)

    if opts.figs not in ('identify', 'gs'):
        parser.error("unknown figure method %r; choose 'identify' or 'gs'" %
                     opts.figs)


def main(argv=None):
    parser = build_parser()
    opts, args = parser.parse_args(argv)
    validate_options(parser, opts)

    orig_eps_pdf_files = glob.glob('*-eps-converted-to.pdf')

    for tex_file in args:
        if os.path.dirname(tex_file) != "":
            raise ValueError(
                'Trying to run on %s, but script only works for files in current directory' %
                tex_file)

        process(tex_file, opts)

    for eps_pdf_file in glob.glob('*-eps-converted-to.pdf'):
        if eps_pdf_file not in orig_eps_pdf_files:
            os.remove(eps_pdf_file)


if __name__ == '__main__':
    main()
